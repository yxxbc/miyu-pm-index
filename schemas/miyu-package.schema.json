{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yxxbc/miyu-pm/schemas/miyu-package.schema.json",
  "title": "miyu-package",
  "description": "Schema for miyu-package.yaml, the package descriptor used by the miyu-pm registry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "type",
    "version",
    "license",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 128
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "type": {
      "type": "string",
      "enum": [
        "mcp",
        "skill",
        "script",
        "plugin",
        "app"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "min_miyu_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "git",
            "release",
            "copy"
          ],
          "default": "git"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "default": "."
        },
        "runtime": {
          "type": "string",
          "enum": [
            "python",
            "node",
            "go",
            "rust",
            "binary",
            "none",
            "other"
          ]
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "minLength": 1,
          "maxLength": 128
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1,
          "default": "SKILL.md"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [
            "**"
          ]
        }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "string",
          "enum": [
            "none",
            "flags"
          ],
          "default": "none"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version"
      ],
      "properties": {
        "api_version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "min_miyu_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repo",
        "asset_pattern"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "github"
          ]
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "asset_pattern": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "mcp"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "mcp"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "skill"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "skill"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "script"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "script"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plugin"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "plugin"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "app"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "release"
        ]
      }
    }
  ]
}
