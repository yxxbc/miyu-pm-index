        ".venv/bin/pip install -r requirements.txt"
      ]
    },
    "mcp": {
      "id": "bilibili-summary",
      "command": "{root}/.venv/bin/python",
      "args": [
        "-B",
        "{root}/bilibili_mcp.py"
      ],
      "env": {
        "BILIBILI_SESSDATA": "{env:BILIBILI_SESSDATA}",
        "BILIBILI_COOKIE": "{env:BILIBILI_COOKIE}"
      },
      "timeout_seconds": 60
    }
  }
